---
import type { Product, ProductColor } from '../data/products';
import SalePrice from './SalePrice.astro';
import { colorLabel, productUrl } from '../lib/catalog';

interface Props {
  product: Product;
  color: ProductColor;
}

const { product, color } = Astro.props;
const label = colorLabel(product.category, color.name);
const hay = `${color.name} ${label} ${product.name} ${product.category} shirt trouser jeans`.toLowerCase();
---

<a class="pcard" href={productUrl(product, color.name)} data-hay={hay}>
  <div class="pcard-media">
    <img src={color.image} alt={label} width="800" height="1008" loading="lazy" />
  </div>
  <div class="pcard-row">
    <h3>{label}</h3>
    <SalePrice price={product.price} />
  </div>
  <p class="pcard-off"><span class="price-off">50% off</span> · Sizes {product.sizes.join(' · ')}</p>
</a>
