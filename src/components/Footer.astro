---
import Icon from './Icon.astro';
import { categories } from '../data/products';
import { site, orderingEnabled } from '../config';
import { whatsappUrl } from '../scripts/order';

const year = new Date().getFullYear();
const chatUrl = orderingEnabled ? whatsappUrl(site.whatsappNumber, 'Hi Essential Outfits!') : null;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="brand">
      <a class="logo" href="/">Essential Outfits</a>
      <p class="muted">{site.tagline} Pick your fit online, then order and pay over WhatsApp.</p>
      <div class="social">
        {
          chatUrl && (
            <a href={chatUrl} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
              <Icon name="chat" />
            </a>
          )
        }
        {
          site.instagram && (
            <a href={`https://instagram.com/${site.instagram}`} target="_blank" rel="noopener" aria-label="Instagram">
              <Icon name="instagram" />
            </a>
          )
        }
        {
          site.email && (
            <a href={`mailto:${site.email}`} aria-label="Email us">
              <Icon name="mail" />
            </a>
          )
        }
      </div>
    </div>

    <nav aria-label="Shop">
      <h2>Shop</h2>
      <ul>
        <li><a href="/shop/">All products</a></li>
        {categories.map((c) => <li><a href={`/shop/${c.slug}/`}>{c.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Help">
      <h2>Help</h2>
      <ul>
        <li><a href="/contact/">Contact us</a></li>
        <li><a href="/shipping-returns/">Shipping &amp; returns</a></li>
        <li><a href="/#how-it-works">How ordering works</a></li>
      </ul>
    </nav>

    <nav aria-label="Company">
      <h2>Company</h2>
      <ul>
        <li><a href="/about/">About us</a></li>
        <li><a href="/privacy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms of use</a></li>
      </ul>
    </nav>
  </div>

  <div class="container legal">
    <p>© {year} {site.legalName || site.name}. All rights reserved.</p>
    <p>All prices are in Indian rupees (₹).</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--ink);
    color: #e9e5de;
    padding-top: 64px;
  }

  .footer-grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 1fr 1fr;
  }

  .brand {
    grid-column: 1 / -1;
    max-width: 22rem;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    text-decoration: none;
    color: #fff;
  }

  .brand p {
    margin-top: 12px;
    color: #b9b3a9;
  }

  .social {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid #45423c;
    border-radius: 50%;
    color: #fff;
  }

  .social a:hover {
    background: #2a2925;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9d978c;
    margin-bottom: 14px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  nav a {
    text-decoration: none;
    color: #e9e5de;
    font-size: 0.95rem;
  }

  nav a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-block: 24px;
    border-top: 1px solid #34322d;
    font-size: 0.85rem;
    color: #9d978c;
  }

  .legal p {
    margin: 0;
  }

  @media (min-width: 860px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }

    .brand {
      grid-column: auto;
    }
  }
</style>
