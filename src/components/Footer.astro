---
import Icon from './Icon.astro';
import { phoneDisplay, phoneTel, site, orderingEnabled } from '../config';
const year = new Date().getFullYear();
const instagram = site.instagram ? `https://instagram.com/${site.instagram}` : 'https://instagram.com';
const whatsapp = orderingEnabled ? `https://wa.me/${site.whatsappNumber}` : '/contact/';
const phone = phoneDisplay();
---

<footer class="site-footer">
  <div class="container foot-grid">
    <div class="brand">
      <a class="logo" href="/" aria-label="Essential Outfits home">
        <span class="logo-name">Essential</span>
        <span class="logo-sub"><span></span>Outfits<span></span></span>
      </a>
      <p class="tag">Dress Better. Live Smarter.</p>
      <div class="social">
        <a href={instagram} target="_blank" rel="noreferrer" aria-label="Instagram"><Icon name="instagram" size={20} /></a>
        <a href="https://facebook.com" target="_blank" rel="noreferrer" aria-label="Facebook"><Icon name="facebook" size={20} /></a>
        <a href={whatsapp} target="_blank" rel="noreferrer" aria-label="WhatsApp"><Icon name="chat" size={20} /></a>
      </div>
    </div>

    <nav class="col" aria-label="Collections">
      <p class="eyebrow gold">Collections</p>
      <a href="/shirts/">Shirts</a>
      <a href="/trousers/">Trousers</a>
      <a href="/combinations/">Style Combinations</a>
    </nav>

    <nav class="col" aria-label="Policies">
      <p class="eyebrow gold">Policies</p>
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/shipping-policy/">Shipping Policy</a>
      <a href="/returns/">Return &amp; Refund Policy</a>
    </nav>

    <div class="col">
      <p class="eyebrow gold">Customer Support</p>
      {
        phoneTel && (
          <a class="phone" href={`tel:${phoneTel}`}>
            <Icon name="phone" size={16} />
            {phone}
          </a>
        )
      }
      <p class="quiet">Calls accepted after 5 PM</p>
      <p class="quiet">Delivery available across India</p>
    </div>
  </div>
  <p class="legal">© {year} Essential Outfits. All rights reserved.</p>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--ink-fg);
    margin-top: auto;
  }

  .foot-grid {
    display: grid;
    gap: 48px;
    padding-block: 64px;
  }

  @media (min-width: 768px) {
    .foot-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }

  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.35em;
    text-indent: 0.35em;
    text-transform: uppercase;
  }

  .logo-sub {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    color: var(--gold);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
    text-transform: uppercase;
  }

  .logo-sub span {
    width: 16px;
    height: 1px;
    background: var(--gold);
  }

  .tag {
    margin-top: 16px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: color-mix(in oklch, var(--ink-fg) 80%, transparent);
  }

  .social {
    display: flex;
    gap: 16px;
    margin-top: 16px;
  }

  .social a:hover,
  .col a:hover,
  .phone:hover {
    color: var(--gold);
  }

  .col {
    display: grid;
    align-content: start;
    gap: 12px;
    font-size: 0.92rem;
  }

  .col a {
    opacity: 0.8;
  }

  .col a:hover {
    opacity: 1;
  }

  .phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    opacity: 0.8;
  }

  .quiet {
    opacity: 0.6;
  }

  .legal {
    border-top: 1px solid color-mix(in oklch, var(--ink-fg) 10%, transparent);
    padding: 24px 20px;
    text-align: center;
    font-size: 0.75rem;
    opacity: 0.5;
  }
</style>
