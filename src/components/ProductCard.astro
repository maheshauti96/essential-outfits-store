---
import Price from './Price.astro';
import { imageFor, productUrl } from '../lib/catalog';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  /** Load the image eagerly (for cards above the fold). */
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const colors = product.colors;
---

<article class="card">
  <a class="media" href={productUrl(product)} tabindex="-1" aria-hidden="true">
    <img
      src={imageFor(product)}
      alt=""
      width="400"
      height="500"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    {product.soldOut && <span class="badge">Sold out</span>}
  </a>
  <div class="info">
    <h3><a href={productUrl(product)}>{product.name}</a></h3>
    <Price price={product.price} compareAt={product.compareAtPrice} />
    <div class="swatches" aria-label={`${colors.length} colour${colors.length === 1 ? '' : 's'}: ${colors.map((c) => c.name).join(', ')}`}>
      {colors.slice(0, 5).map((c) => <span class="dot" style={`--c:${c.hex}`} title={c.name} />)}
      {colors.length > 5 && <span class="more">+{colors.length - 5}</span>}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
  }

  .media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background: var(--media);
    overflow: hidden;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    padding: 6%;
    transition: transform 0.4s ease;
  }

  .card:hover .media img {
    transform: scale(1.04);
  }

  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .info {
    padding-top: 14px;
    display: grid;
    gap: 4px;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.35;
    margin: 0;
    letter-spacing: 0;
  }

  h3 a {
    text-decoration: none;
  }

  /* Whole card is clickable via the title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h3 a:focus-visible {
    outline: none;
  }

  .card:has(h3 a:focus-visible) .media {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .swatches {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
  }

  .more {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
