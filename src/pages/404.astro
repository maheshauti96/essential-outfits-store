---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <div class="miss">
    <p class="eyebrow gold">404</p>
    <h1>This page has moved on.</h1>
    <p>The link may be old, or the piece is no longer in the collection.</p>
    <div class="actions">
      <a class="btn" href="/shirts/">Shop Shirts</a>
      <a class="btn btn-outline" href="/">Home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .miss {
    max-width: 40rem;
    margin-inline: auto;
    padding: 96px 20px 120px;
    text-align: center;
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
  }

  .miss p:not(.eyebrow) {
    margin-top: 16px;
    color: var(--muted-fg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
