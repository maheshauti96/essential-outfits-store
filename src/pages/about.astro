---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Essential Outfits was created for the modern Indian man who values quiet confidence over loud trends."
>
  <header class="page-head">
    <p class="eyebrow gold">About Essential Outfits</p>
    <h1>Dress Better. Live Smarter.</h1>
  </header>
  <div class="container about">
    <img src="/products/t-black.jpg" alt="Essential Outfits look" width="800" height="1008" />
    <div class="copy">
      <p>
        Essential Outfits was created for the modern Indian man — the college student, the young professional and the
        office-going gentleman who values quiet confidence over loud trends.
      </p>
      <p>
        We focus on the essentials: well-cut shirts and trousers in versatile colours, made from comfortable fabrics and
        priced honestly. Pieces that mix effortlessly and last season after season.
      </p>
      <p>Every collection is produced in limited quantities, and we deliver across India.</p>
      <div class="actions">
        <a class="btn" href="/shirts/">Our Shirts</a>
        <a class="btn btn-outline" href="/trousers/">Our Trousers</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 48px;
    align-items: center;
    padding-bottom: 96px;
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: 1fr 1fr;
    }
  }

  .about img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .copy {
    display: grid;
    gap: 20px;
    color: var(--muted-fg);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
</style>
