---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import Icon from '../components/Icon.astro';
import { art } from '../lib/catalog';
---

<BaseLayout title="About us" description="Essential Outfits makes everyday menswear: the handful of pieces you wear most, done well.">
  <div class="container">
    <PageHeader
      eyebrow="About us"
      title="Fewer, better basics."
      intro="Most of what we wear every day comes down to a handful of pieces. Essential Outfits is about getting those pieces right."
    />

    <div class="about-grid">
      <div class="prose">
        <h2>Why we started</h2>
        <p>
          A good tee, a shirt that works for the office and the weekend, trousers that go with all of it. These are the
          clothes you reach for every morning, so they should fit well, feel good and be easy to put together.
        </p>
        <p><Todo>your story — who you are, where you're based, and why you started Essential Outfits.</Todo></p>

        <h2>What we make</h2>
        <p>
          We keep our range focused on menswear essentials: tees, polos, shirts, hoodies, trousers, shorts and light
          jackets, in colours chosen to work together. Mix any top with any bottom and it should just work.
        </p>

        <h2>How we sell</h2>
        <p>
          We keep things personal. Browse the shop, add what you like to your cart, and send the order to us on WhatsApp.
          We confirm sizes, stock, delivery and payment with you directly — and we're there if you need help choosing.
        </p>

        <p><a class="btn btn-accent" href="/shop/">Shop the collection <Icon name="arrow" /></a></p>
      </div>

      <div class="about-art" aria-hidden="true">
        <img src={art.aboutJacket} alt="" width="400" height="500" />
        <img src={art.aboutPolo} alt="" width="400" height="500" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: 40px;
    padding-bottom: clamp(56px, 8vw, 104px);
  }

  .about-grid .prose h2:first-child {
    margin-top: 1em;
  }

  .about-art {
    position: relative;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) * 1.5);
    background: var(--media);
  }

  .about-art img {
    position: absolute;
    width: 52%;
    height: auto;
  }

  .about-art img:first-child {
    left: 6%;
    top: 8%;
    transform: rotate(-5deg);
  }

  .about-art img:last-child {
    right: 6%;
    bottom: 6%;
    transform: rotate(4deg);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 64px;
      align-items: start;
    }

    .about-art {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
</style>
