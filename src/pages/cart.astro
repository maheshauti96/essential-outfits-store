---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config';
import { formatPrice } from '../lib/catalog';
---

<BaseLayout title="Your Bag" description="Review your bag and send the order on WhatsApp." noindex>
  <section class="container cart" data-cart-page data-number={site.whatsappNumber}>
    <header class="page-head cart-head">
      <p class="eyebrow gold">Checkout</p>
      <h1>Your Bag</h1>
    </header>

    <noscript>
      <p class="muted">The bag needs JavaScript. Please enable it, or message us from the Contact page.</p>
    </noscript>

    <div class="empty" data-empty hidden>
      <p>Your bag is empty.</p>
      <a class="btn" href="/shirts/">Shop Shirts</a>
    </div>

    <div class="cart-grid" data-filled hidden>
      <div>
        <ul class="lines" data-lines aria-label="Items in your bag"></ul>
        <button class="clear" type="button" data-clear>Clear bag</button>
      </div>

      <aside class="summary">
        <h2>Order summary</h2>
        <dl>
          <div><dt>Items</dt><dd data-item-count>0</dd></div>
          <div><dt>Total</dt><dd data-subtotal>{formatPrice(0)}</dd></div>
          <div><dt>Delivery</dt><dd class="muted">Confirmed on WhatsApp</dd></div>
        </dl>

        <form class="checkout" data-checkout novalidate>
          <h3>Your details</h3>
          <p class="muted small">Added to the WhatsApp message so we can quote delivery.</p>
          <div class="field">
            <label for="c-name">Name</label>
            <input id="c-name" name="name" autocomplete="name" required maxlength="60" />
          </div>
          <div class="field">
            <label for="c-address">Address</label>
            <textarea
              id="c-address"
              name="address"
              autocomplete="street-address"
              required
              rows="3"
              maxlength="240"
              placeholder="House, street, area, landmark"
            ></textarea>
          </div>
          <div class="two">
            <div class="field">
              <label for="c-city">City</label>
              <input id="c-city" name="city" autocomplete="address-level2" required maxlength="40" />
            </div>
            <div class="field">
              <label for="c-pin">PIN code</label>
              <input
                id="c-pin"
                name="pincode"
                autocomplete="postal-code"
                inputmode="numeric"
                pattern="[1-9][0-9]{5}"
                maxlength="6"
                required
              />
            </div>
          </div>
          <div class="field">
            <label for="c-notes">Notes <span class="muted">(optional)</span></label>
            <textarea id="c-notes" name="notes" rows="2" maxlength="300"></textarea>
          </div>
          <p class="error" data-form-error hidden></p>
          <button class="btn btn-wa" type="submit">
            <Icon name="chat" size={16} />
            Send order on WhatsApp
          </button>
          <p class="muted small">Opens WhatsApp with your order filled in. Nothing is charged here.</p>
        </form>
        <p class="sent" data-sent hidden>Order sent? We'll reply on WhatsApp to confirm.</p>
      </aside>
    </div>

    <template data-line-template>
      <li class="line">
        <a class="thumb" data-link tabindex="-1" aria-hidden="true"><img alt="" width="96" height="120" data-img /></a>
        <div>
          <a class="line-name" data-link data-name></a>
          <p class="muted small" data-variant></p>
          <p class="small" data-unit></p>
          <div class="line-controls">
            <div class="qty">
              <button type="button" data-dec aria-label="Decrease"><Icon name="minus" size={14} /></button>
              <span data-qty></span>
              <button type="button" data-inc aria-label="Increase"><Icon name="plus" size={14} /></button>
            </div>
            <button class="remove" type="button" data-remove>Remove</button>
          </div>
        </div>
        <p class="line-total" data-total></p>
      </li>
    </template>
  </section>
</BaseLayout>

<script>
  import { setQty, clearCart, MAX_QTY, cartCount } from '../scripts/cart';
  import { bagTotal, resolvedLines, toOrderLines } from '../scripts/bag';
  import { renderSalePrice } from '../lib/catalog';
  import { orderMessage, readCustomer, saveCustomer, sendOrder } from '../scripts/order';

  const root = document.querySelector<HTMLElement>('[data-cart-page]');
  if (root) {
    const list = root.querySelector<HTMLUListElement>('[data-lines]')!;
    const template = root.querySelector<HTMLTemplateElement>('[data-line-template]')!;
    const form = root.querySelector<HTMLFormElement>('[data-checkout]')!;
    const formError = root.querySelector<HTMLElement>('[data-form-error]')!;

    const saved = readCustomer();
    for (const key of ['name', 'address', 'city', 'pincode', 'notes'] as const) {
      const field = form.elements.namedItem(key);
      if ((field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) && saved[key]) field.value = saved[key];
    }
    form.addEventListener('input', () => {
      const data = new FormData(form);
      saveCustomer({
        name: String(data.get('name') || '').trim(),
        address: String(data.get('address') || '').trim(),
        city: String(data.get('city') || '').trim(),
        pincode: String(data.get('pincode') || '').trim(),
        notes: String(data.get('notes') || '').trim(),
      });
    });

    function render() {
      const lines = resolvedLines();
      root!.querySelector<HTMLElement>('[data-empty]')!.hidden = lines.length > 0;
      root!.querySelector<HTMLElement>('[data-filled]')!.hidden = lines.length === 0;
      list.replaceChildren(
        ...lines.map((item) => {
          const node = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
          node.querySelectorAll<HTMLAnchorElement>('[data-link]').forEach((a) => (a.href = item.url));
          const img = node.querySelector<HTMLImageElement>('[data-img]')!;
          img.src = item.image;
          img.alt = item.label;
          node.querySelector('[data-name]')!.textContent = item.label;
          node.querySelector('[data-variant]')!.textContent = `${item.line.color} · Size ${item.line.size}`;
          renderSalePrice(node.querySelector<HTMLElement>('[data-unit]')!, item.product.price);
          node.querySelector('[data-qty]')!.textContent = String(item.line.qty);
          renderSalePrice(node.querySelector<HTMLElement>('[data-total]')!, item.product.price * item.line.qty);
          const dec = node.querySelector<HTMLButtonElement>('[data-dec]')!;
          const inc = node.querySelector<HTMLButtonElement>('[data-inc]')!;
          inc.disabled = item.line.qty >= MAX_QTY;
          dec.addEventListener('click', () => setQty(item.index, item.line.qty - 1));
          inc.addEventListener('click', () => setQty(item.index, item.line.qty + 1));
          node.querySelector('[data-remove]')!.addEventListener('click', () => setQty(item.index, 0));
          return node;
        }),
      );
      root!.querySelector('[data-item-count]')!.textContent = String(cartCount(lines.map((l) => l.line)));
      renderSalePrice(root!.querySelector<HTMLElement>('[data-subtotal]')!, bagTotal(lines));
    }

    root.querySelector('[data-clear]')?.addEventListener('click', () => {
      if (confirm('Remove everything from your bag?')) clearCart();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      formError.hidden = true;
      const invalid = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')].find(
        (field) => !field.checkValidity() || (field.required && !field.value.trim()),
      );
      if (invalid) {
        formError.textContent =
          invalid.name === 'pincode' && invalid.value
            ? 'Please enter a valid 6-digit PIN code.'
            : 'Please fill in your name, address, city and PIN code.';
        formError.hidden = false;
        invalid.focus();
        return;
      }
      const lines = resolvedLines();
      if (!lines.length) return;
      const data = new FormData(form);
      const message = orderMessage(toOrderLines(lines), {
        name: String(data.get('name') || '').trim(),
        address: String(data.get('address') || '').trim(),
        city: String(data.get('city') || '').trim(),
        pincode: String(data.get('pincode') || '').trim(),
        notes: String(data.get('notes') || '').trim(),
      });
      if (sendOrder(root!.dataset.number, message)) {
        root!.querySelector<HTMLElement>('[data-sent]')!.hidden = false;
      }
    });

    render();
    window.addEventListener('cart:change', render);
  }
</script>

<style>
  .cart-head {
    padding-bottom: 12px;
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 20px;
    padding: 24px 0 80px;
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.8rem;
  }

  .empty[hidden],
  .cart-grid[hidden] {
    display: none;
  }

  .cart-grid {
    display: grid;
    gap: 40px;
    padding-bottom: 96px;
  }

  @media (min-width: 960px) {
    .cart-grid {
      grid-template-columns: 1fr 380px;
      align-items: start;
    }

    .summary {
      position: sticky;
      top: calc(var(--header-h) + 20px);
    }
  }

  .lines {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .line {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  .thumb {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--muted);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .line-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .small {
    margin-top: 4px;
    font-size: 0.85rem;
  }

  .line-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
  }

  .qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
  }

  .qty button {
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .qty span {
    width: 24px;
    text-align: center;
  }

  .remove {
    border: 0;
    background: none;
    color: var(--muted-fg);
    cursor: pointer;
    font-size: 0.85rem;
  }

  .line-total {
    font-weight: 600;
  }

  .clear {
    margin-top: 16px;
    border: 0;
    background: none;
    color: var(--muted-fg);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .summary {
    border: 1px solid var(--line);
    background: var(--card);
    padding: 28px;
  }

  .summary h2 {
    font-size: 2rem;
  }

  .summary dl {
    margin: 20px 0;
  }

  .summary dl div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }

  .checkout {
    display: grid;
    gap: 14px;
  }

  .checkout h3 {
    font-size: 1.5rem;
  }

  .two {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 560px) {
    .two {
      grid-template-columns: 1fr 1fr;
    }
  }

  .error {
    color: oklch(45% 0.16 27);
    font-size: 0.9rem;
  }

  .error[hidden],
  .sent[hidden] {
    display: none;
  }

  .sent {
    margin-top: 16px;
  }
</style>
