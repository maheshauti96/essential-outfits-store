---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { orderingEnabled, phoneDisplay, phoneTel, site } from '../config';
import { whatsappUrl } from '../scripts/order';

const instagram = site.instagram ? `https://instagram.com/${site.instagram}` : 'https://instagram.com';
const cards = [
  {
    icon: 'chat' as const,
    title: 'WhatsApp Ordering',
    body: 'Chat with us to place an order',
    href: orderingEnabled ? whatsappUrl(site.whatsappNumber, 'Hello Essential Outfits, I have a question.') : undefined,
  },
  {
    icon: 'phone' as const,
    title: 'Customer Support',
    body: `${phoneDisplay()} · Calls accepted after 5 PM`,
    href: phoneTel ? `tel:${phoneTel}` : undefined,
  },
  {
    icon: 'instagram' as const,
    title: 'Instagram',
    body: 'Follow our latest drops',
    href: instagram,
  },
  {
    icon: 'facebook' as const,
    title: 'Facebook',
    body: 'Join our community',
    href: 'https://facebook.com',
  },
  {
    icon: 'truck' as const,
    title: 'Delivery',
    body: 'Available across India',
  },
];
---

<BaseLayout title="Contact" description="We're here to help you find your perfect fit. Order on WhatsApp or call after 5 PM.">
  <header class="page-head">
    <p class="eyebrow gold">Get in touch</p>
    <h1>Contact Us</h1>
    <p class="lede">We're here to help you find your perfect fit.</p>
  </header>
  <div class="container cards">
    {
      cards.map((card) => {
        const inner = (
          <div class="card">
            <Icon name={card.icon} size={24} strokeWidth={1.5} />
            <h2>{card.title}</h2>
            <p>{card.body}</p>
          </div>
        );
        return card.href ? (
          <a href={card.href} target={card.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
            {inner}
          </a>
        ) : (
          inner
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .cards {
    display: grid;
    gap: 20px;
    padding-bottom: 96px;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card {
    height: 100%;
    border: 1px solid var(--line);
    background: var(--card);
    padding: 32px;
    transition: border-color 0.15s;
  }

  a:hover .card {
    border-color: var(--gold);
  }

  .card :global(svg) {
    color: var(--gold);
  }

  h2 {
    margin-top: 20px;
    font-size: 1.7rem;
  }

  .card p {
    margin-top: 8px;
    font-size: 0.9rem;
    color: var(--muted-fg);
  }
</style>
