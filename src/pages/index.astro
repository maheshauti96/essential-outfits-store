---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import StockBanner from '../components/StockBanner.astro';
import { categories, productByCategory } from '../data/products';
import { looks } from '../data/looks';
import SalePrice from '../components/SalePrice.astro';

const shirts = productByCategory('shirts');
const trousers = productByCategory('trousers');
const collections = [
  { href: '/shirts/', image: categories[0]!.image, title: 'Shirts', price: shirts.price },
  { href: '/trousers/', image: categories[1]!.image, title: 'Trousers', price: trousers.price },
  { href: '/combinations/', image: '/products/t-bluejeans.jpg', title: 'Style Combinations' },
];
---

<BaseLayout image="/hero.jpg">
  <section class="hero">
    <img src="/hero.jpg" alt="Man in a white shirt and beige trousers" width="1600" height="1008" />
    <div class="hero-copy">
      <div class="container">
        <div class="hero-text fade-up">
          <p class="eyebrow gold">New Season · Essentials</p>
          <h1>Style that defines you.</h1>
          <p class="lede">Discover timeless essentials for college, office and everyday wear.</p>
          <div class="hero-actions">
            <a class="btn" href="/shirts/">Shop Shirts</a>
            <a class="btn btn-outline" href="/trousers/">Shop Trousers</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="collections-heading">
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow gold">Featured Collections</p>
        <h2 id="collections-heading">Curated for the modern gentleman</h2>
      </div>
      <div class="collections">
        {
          collections.map((c) => (
            <a class="collection" href={c.href}>
              <img src={c.image} alt="" width="800" height="1008" loading="lazy" />
              <span class="collection-caption">
                {
                  c.price != null ? (
                    <SalePrice price={c.price} prefix="From" />
                  ) : (
                    <span class="eyebrow gold">Complete looks</span>
                  )
                }
                <span class="collection-title">{c.title}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <StockBanner />

  <section class="section" aria-labelledby="new-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow gold">Just In</p>
          <h2 id="new-heading">New Arrivals</h2>
        </div>
        <a class="link-underline" href="/shirts/">View all</a>
      </div>
      <ProductGrid category="shirts" limit={4} />
    </div>
  </section>

  <section class="band" aria-labelledby="best-heading">
    <div class="container section">
      <div class="section-head">
        <div>
          <p class="eyebrow gold">Most Loved</p>
          <h2 id="best-heading">Bestsellers</h2>
        </div>
        <a class="link-underline" href="/trousers/">View all</a>
      </div>
      <ProductGrid category="trousers" limit={4} />
    </div>
  </section>

  <section class="section" aria-labelledby="looks-heading">
    <div class="container">
      <div class="section-intro">
        <p class="eyebrow gold">Style Combinations</p>
        <h2 id="looks-heading">Wear it together</h2>
      </div>
      <div class="looks">
        {
          looks.slice(0, 4).map((look) => (
            <a class="pcard" href="/combinations/">
              <div class="pcard-media">
                <img src={look.image} alt={look.title} width="800" height="1008" loading="lazy" />
              </div>
              <p class="look-title">{look.title}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--beige);
  }

  .hero img {
    width: 100%;
    height: 78vh;
    min-height: 520px;
    object-fit: cover;
    /* Wide desktops crop this landscape photo vertically. Pin to the top so his head stays in frame. */
    object-position: 72% top;
  }

  .hero-copy {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }

  .hero-text {
    max-width: 36rem;
  }

  .hero h1 {
    margin-top: 20px;
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .lede {
    margin-top: 24px;
    max-width: 28rem;
    color: var(--muted-fg);
    font-size: 1.05rem;
  }

  @media (max-width: 760px) {
    .hero-copy {
      align-items: flex-end;
      padding-bottom: 36px;
      background: linear-gradient(to top, oklch(18% 0.01 60 / 0.78), oklch(18% 0.01 60 / 0.2) 46%, transparent 70%);
    }

    .hero h1,
    .hero .lede {
      color: var(--ink-fg);
    }

    .hero h1 {
      font-size: 3.15rem;
    }

    .hero .btn-outline {
      color: var(--ink-fg);
      border-color: var(--ink-fg);
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .fade-up {
    animation: fadeUp 0.8s ease both;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .collections {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .collections {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .collection {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--muted);
    color: var(--ink-fg);
  }

  .collection img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .collection:hover img {
    transform: scale(1.05);
  }

  .collection-caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: grid;
    gap: 4px;
    padding: 24px;
    background: linear-gradient(to top, color-mix(in oklch, var(--ink) 70%, transparent), transparent);
  }

  .collection .price-was {
    color: color-mix(in oklch, var(--ink-fg) 72%, transparent);
  }

  .collection .price-now {
    color: var(--ink-fg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .collection-title {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1.1;
  }

  .band {
    background: var(--muted);
  }

  .looks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  @media (min-width: 768px) {
    .looks {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .look-title {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.25;
  }
</style>
