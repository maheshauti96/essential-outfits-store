---
import BaseLayout from '../layouts/BaseLayout.astro';
import { phoneDisplay } from '../config';

const paragraphs = [
  'Delivery is available across India.',
  'Orders are typically dispatched within 1–3 business days. Delivery times vary by location.',
  "Once your order ships, we'll share tracking details with you on WhatsApp or email.",
  `For shipping queries, call ${phoneDisplay()} (calls accepted after 5 PM).`,
];
---

<BaseLayout title="Shipping Policy" description="Delivery across India. Orders are typically dispatched within 1–3 business days.">
  <header class="page-head">
    <p class="eyebrow gold">Policies</p>
    <h1>Shipping Policy</h1>
  </header>
  <div class="prose">
    {paragraphs.map((p) => <p>{p}</p>)}
  </div>
</BaseLayout>
