---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopListing from '../../components/ShopListing.astro';
import { categories, productsIn, type Category } from '../../data/products';
import { absoluteUrl } from '../../lib/catalog';

export const getStaticPaths = (() =>
  categories.map((category) => ({ params: { category: category.slug }, props: { category } }))) satisfies GetStaticPaths;

const { category } = Astro.props as { category: Category };
const items = productsIn(category.slug);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Shop', item: absoluteUrl('/shop/') },
    { '@type': 'ListItem', position: 2, name: category.name, item: absoluteUrl(`/shop/${category.slug}/`) },
  ],
};
---

<BaseLayout
  title={`Men's ${category.name}`}
  description={`Shop men's ${category.name.toLowerCase()} from Essential Outfits. ${category.blurb}`}
  jsonLd={[breadcrumbs]}
>
  <ShopListing title={category.name} intro={category.blurb} items={items} active={category.slug} />
</BaseLayout>
