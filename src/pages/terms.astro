---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Todo from '../components/Todo.astro';
import { site } from '../config';

const owner = site.legalName || site.name;
---

<BaseLayout title="Terms of use" description="The terms for using essentialoutfits.store and ordering from Essential Outfits.">
  <div class="container page">
    <PageHeader eyebrow="Legal" title="Terms of use" />

    <div class="prose">
      <p class="muted">Last updated: 6 November 2026</p>
      <p>
        These terms apply when you use essentialoutfits.store, run by {owner}. By using the website or placing an order,
        you agree to them.
      </p>

      <h2>Products and prices</h2>
      <ul>
        <li>Prices are in Indian rupees (₹). Delivery charges are confirmed separately before you pay.</li>
        <li>We try to show colours and details accurately, but they can look slightly different on different screens.</li>
        <li>Prices and availability can change. The price that applies is the one we confirm with you on WhatsApp.</li>
      </ul>

      <h2>Orders</h2>
      <p>
        Sending your cart on WhatsApp is a request to order. Your order is accepted once we confirm it and you've paid. We
        may decline an order, for example if an item is out of stock, and will refund any payment in that case.
      </p>

      <h2>Exchanges and returns</h2>
      <p>See our <a href="/shipping-returns/">shipping &amp; returns policy</a>.</p>

      <h2>Use of this website</h2>
      <p>
        The content on this website — including text, images and design — belongs to {owner}. Please don't copy or reuse
        it without permission.
      </p>

      <h2>Liability</h2>
      <p>
        We're responsible for the products we sell as described here and as required by law. We're not responsible for
        losses that weren't foreseeable or that are caused by things outside our reasonable control.
      </p>

      <h2>Governing law</h2>
      <p>
        These terms are governed by the laws of India. <Todo>the city whose courts handle disputes.</Todo>
      </p>

      <h2>Contact</h2>
      <p>Questions about these terms? Reach us from our <a href="/contact/">contact page</a>.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-bottom: clamp(56px, 8vw, 104px);
  }
</style>
