---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import StockBanner from '../components/StockBanner.astro';
import { productByCategory } from '../data/products';
import { formatPrice } from '../lib/catalog';

const product = productByCategory('trousers');
---

<BaseLayout title="Trousers" description={`${product.summary} Starting at ${formatPrice(product.price)}.`}>
  <header class="page-head">
    <p class="eyebrow gold">The Trouser Collection</p>
    <h1>Trousers</h1>
    <p class="lede">Tailored trousers and stretch denim. Starting at {formatPrice(product.price)}.</p>
  </header>
  <div class="container" style="padding-bottom: 96px">
    <ProductGrid category="trousers" />
  </div>
  <StockBanner />
</BaseLayout>
